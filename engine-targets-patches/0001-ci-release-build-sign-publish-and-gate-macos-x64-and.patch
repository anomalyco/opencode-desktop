     if: >-
       ${{ !cancelled()
       && needs.plan.outputs.build-desktop == 'true'
       && needs.credentials.result == 'success'
-      && (needs.plan.outputs.build-engine != 'true' || needs.build-engine-linux-x64.result == 'success') }}
+      && (needs.plan.outputs.build-engine != 'true' || needs.build-engine-linux.result == 'success') }}
     strategy:
       matrix:
         include:
@@ -226,6 +227,7 @@ jobs:
       digest-x64: ${{ steps.digest.outputs.digest-x64 }}
       digest-arm64: ${{ steps.digest.outputs.digest-arm64 }}
       linux-x64-engine-sha256: ${{ steps.engine-trust.outputs.linux-x64-engine-sha256 }}
+      linux-arm64-engine-sha256: ${{ steps.engine-trust.outputs.linux-arm64-engine-sha256 }}
     steps:
       - *build-checkout
       - name: Install native build and packaging dependencies
@@ -241,20 +243,17 @@ jobs:
           path: ~/.cache/seer/ghostty-vt
           key: ghostty-vt-linux-${{ matrix.arch }}-${{ hashFiles('crates/terminal/build.rs', 'crates/terminal/build_support.rs') }}
       - id: engine-trust
-        if: matrix.arch == 'x64'
-        name: Resolve Linux x64 browser engine sha256 pin
+        name: Resolve Linux ${{ matrix.arch }} browser engine sha256 pin
