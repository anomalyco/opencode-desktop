           }
           .github/release/opencode-rune-verify-windows.ps1 -Folders $unpacked -Publisher $publisher
           "Windows browser engines ($env:ENGINE_VERSION, x64 + arm64): signed by $publisher." >> $env:GITHUB_STEP_SUMMARY
+      - name: Verify signed Windows x64 browser engine sandbox
