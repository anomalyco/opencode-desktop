+        run: |
+          .github/release/opencode-rune-verify-engine-windows-sandbox.ps1 -EngineDir "$env:RUNNER_TEMP/verify-engine/x64/OpenCode Browser Engine"
+          "Windows x64 signed browser engine: sandbox verified (CheckDllCodeSigning + Untrusted 0x0000 renderer token)." >> $env:GITHUB_STEP_SUMMARY
 
   verify-engine-macos:
     needs: [plan, sign-engine-macos]
@@ -1022,7 +1045,12 @@ jobs:
           xcrun stapler validate "$app"
           spctl --assess --type execute --verbose=2 "$app"
           codesign --verify --deep --strict -R="anchor apple generic and certificate leaf[subject.OU] = \"$SEER_TEAM_ID\" and notarized" "$app"
+          [ -f "$app/Contents/Frameworks/Chromium Embedded Framework.framework/Libraries/libcef_sandbox.dylib" ] || {
+            echo "::error::Missing libcef_sandbox.dylib in $app." >&2; exit 1;
