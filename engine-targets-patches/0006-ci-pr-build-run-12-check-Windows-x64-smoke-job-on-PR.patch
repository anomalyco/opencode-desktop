+          if (-not $exe) { throw "opencode-desktop.exe not found under $appOut" }
+
+          function Expand-TarZst([string]$ArchivePath, [string]$OutDir) {
+            New-Item -ItemType Directory -Force -Path $OutDir | Out-Null
+            & tar --zstd -xf $ArchivePath -C $OutDir 2>$null
+            if ($LASTEXITCODE -eq 0) { return }
