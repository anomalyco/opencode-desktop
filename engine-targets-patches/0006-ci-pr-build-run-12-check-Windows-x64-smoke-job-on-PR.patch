+    permissions:
+      contents: read
+    env:
+      PR_NUMBER: ${{ needs.plan.outputs.pr-number }}
+      HEAD_SHA: ${{ needs.plan.outputs.head-sha }}
+      BUILD_ENGINE: ${{ needs.plan.outputs.build-engine }}
+    steps:
+      # Check out only the base branch's smoke helper so a PR cannot alter its own check.
+      - name: Check out smoke helper from base branch
+        uses: actions/checkout@3d3c42e5aac5ba805825da76410c181273ba90b1 # v7.0.1
+        with:
+          ref: ${{ github.event.pull_request.base.sha }}
+          sparse-checkout: /.github/release/
+          sparse-checkout-cone-mode: false
+          persist-credentials: false
+      - uses: oven-sh/setup-bun@0c5077e51419868618aeaa5fe8019c62421857d6 # v2
+      - name: Download PR Windows x64 desktop build
+        uses: ./.github/release/download
+        with:
+          pattern: build-opencode-rune-pr-windows-x64
+          folder: smoke-in-app
+          digests: build-opencode-rune-pr-windows-x64=${{ needs.build-windows.outputs.digest-x64 }}
+      - name: Download PR Windows x64 browser engine (engine PRs)
+        if: needs.build-engine-windows-x64.outputs.digest != ''
+        uses: ./.github/release/download
+        with:
+          pattern: build-opencode-rune-pr-engine-windows-x64
+          folder: smoke-in-engine
+          digests: build-opencode-rune-pr-engine-windows-x64=${{ needs.build-engine-windows-x64.outputs.digest }}
+      - name: Resolve published browser engine metadata (non-engine PRs)
+        if: needs.build-engine-windows-x64.outputs.digest == ''
+        id: pub-engine
+        shell: pwsh
+        run: |
+          $idx = Invoke-RestMethod -Uri 'https://anoma.ly/release/opencode-rune/browser-engine/stable.json' -TimeoutSec 30
+          $t = $idx.release.targets.'windows-x64'
+          $url = if ($t.url -match '^https?://') { $t.url } else { "https://anoma.ly$($t.url)" }
+          "version=$($idx.release.version)" | Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append
+          "sha256=$($t.sha256)" | Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append
+          "url=$url" | Out-File -FilePath $env:GITHUB_OUTPUT -Encoding utf8 -Append
+      - name: Restore cached published browser engine
+        if: needs.build-engine-windows-x64.outputs.digest == ''
+        id: cache-engine
+        uses: actions/cache@55cc8345863c7cc4c66a329aec7e433d2d1c52a9 # v6.1.0
+        with:
+          path: ${{ runner.temp }}/pub-engine-cache
+          key: smoke-browser-engine-win-x64-${{ steps.pub-engine.outputs.sha256 }}
+      - name: Unpack desktop app and browser engine
+        id: unpack
+        shell: pwsh
+        env:
+          PUB_ENGINE_URL: ${{ steps.pub-engine.outputs.url }}
+          PUB_ENGINE_SHA256: ${{ steps.pub-engine.outputs.sha256 }}
+        run: |
+          $ErrorActionPreference = 'Stop'
+          $appIn = Join-Path $env:RUNNER_TEMP 'smoke-in-app/build-opencode-rune-pr-windows-x64'
+          $appOut = Join-Path $env:RUNNER_TEMP 'smoke-app'
