+            $zipPath = Join-Path $env:RUNNER_TEMP 'smoke-setup-payload.zip'
+            & bun -e 'import { readFileSync, writeFileSync } from "node:fs"; const [s, d] = process.argv.slice(1); const b = readFileSync(s); for (let i = b.length - 22; i >= 0; i--) { if (b[i]===0x50&&b[i+1]===0x4b&&b[i+2]===0x05&&b[i+3]===0x06) { const o = b.readUInt32LE(i+16), l = b.readUInt32LE(i+12), z = i - o - l; if (z >= 0 && b[z]===0x50 && b[z+1]===0x4b) { writeFileSync(d, b.subarray(z)); process.exit(0); } } } process.exit(1);' $setup.FullName $zipPath
+            if ($LASTEXITCODE -ne 0) { throw "Failed extracting appended ZIP from $($setup.FullName)" }
+            Expand-Archive -LiteralPath $zipPath -DestinationPath $appOut -Force
+          } else {
