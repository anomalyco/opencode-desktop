From bda61412bbf142355e8959722c24ce2defe3dfab Mon Sep 17 00:00:00 2001
From: LukeParkerDev <10430890+Hona@users.noreply.github.com>
Date: Sat, 21 Nov 2026 14:32:31 +1000
Subject: [PATCH] ci(release): fall back to hdiutil detach -force in
 verify-macos

---
 .github/workflows/release.yml | 2 +-
 1 file changed, 1 insertion(+), 1 deletion(-)

diff --git a/.github/workflows/release.yml b/.github/workflows/release.yml
index eabd97b94..04a4f42be 100644
--- a/.github/workflows/release.yml
+++ b/.github/workflows/release.yml
@@ -604,7 +604,7 @@ jobs:
           spctl --assess --type execute --verbose=2 "$check/dmg/OpenCode (Rune).app"
           diff -qr "$check/dmg/OpenCode (Rune).app" "$check/update/OpenCode (Rune).app"
           OPENCODE_RUNE_SMOKE_HEADLESS=1 apps/desktop/scripts/smoke-app.sh "$check/dmg/OpenCode (Rune).app"
-          hdiutil detach -quiet "$check/dmg"
+          hdiutil detach -quiet "$check/dmg" || hdiutil detach -force -quiet "$check/dmg"
           codesign -dv "$check/update/OpenCode (Rune).app" 2>&1 | grep -E '^(Identifier|TeamIdentifier|Authority=Developer)' >> "$GITHUB_STEP_SUMMARY"
 
   # The publisher every signed file carries must be the one the updater checks, read from the app.
-- 
2.56.0.windows.4

