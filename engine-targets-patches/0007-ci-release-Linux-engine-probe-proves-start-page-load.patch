                 browser_pid = int(msg.get("pid", proc.pid))
                 send({
                     "type": "open_tab",
@@ -108,56 +135,145 @@ def main() -> int:
                 })
             elif kind == "tab_update" and msg.get("tab", {}).get("title") == "SandboxProbeOK":
