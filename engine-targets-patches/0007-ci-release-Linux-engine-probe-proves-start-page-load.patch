+        rows = renderer_sandbox(platform, browser_pid, bin_path)
+        if not rows:
+            print(f"{platform}: no renderer subprocess found")
+            if require:
+                raise ProbeError("no renderer subprocess found (--require-sandbox)")
+        for pid, sandboxed, detail in rows:
