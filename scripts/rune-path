#!/usr/bin/env bash
# Prints the path of Rune's scripts/NAME from the checkout this repo is pinned to (the rev in the
# root Cargo.toml), so scripts/mac-app and scripts/rune-hot always run the matching version.
#   scripts/rune-path mac-app
# RUNE=/path/to/rune uses a local checkout instead.
set -euo pipefail
cd "$(dirname "$0")/.."
if [[ -n "${RUNE:-}" ]]; then root=$RUNE; else
  manifest=$(cargo metadata --format-version 1 --locked 2>/dev/null | python3 -c '
import json, sys
for p in json.load(sys.stdin)["packages"]:
    if p["name"] == "rune-mac": print(p["manifest_path"]); break')
  [[ -n $manifest ]] || { echo "rune-path: rune-mac not found in cargo metadata" >&2; exit 1; }
  root=$(dirname "$(dirname "$(dirname "$manifest")")")
fi
f="$root/scripts/$1"
[[ -e $f ]] || { echo "rune-path: no $f" >&2; exit 1; }
echo "$f"
