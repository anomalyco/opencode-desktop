#!/usr/bin/env bash
# The OpenCode (Rune) motion gate: every message and timeline animation, headless on the virtual
# clock, across the circumstance matrix. Prints one line per finding (element key, frame, cell).
# Loops keep their rhythm (loop-jump), and a cell marked quiet stops asking for frames (wakes-after-end).
#   scripts/motion-audit-desktop [CELL-FILTER]
#   scripts/motion-audit-desktop --sheet 'send/pinned/long/wide|134[|path part]'
#   scripts/motion-audit-desktop --dump 'send/pinned/long/wide|path part[|from|to]'
#   scripts/motion-audit-desktop --allowed [CELL-FILTER]   also list allowlisted findings
# The same gate runs in `cargo test -p opencode-desktop` (motion_gate::scenarios).
# Thresholds: Rune's rune::motion_gate RULES; allowlist: apps/desktop/src/motion_gate/scenarios.rs ALLOW.
set -euo pipefail
cd "$(dirname "$0")/.."
OUT=${MOTION_GATE_OUT:-${TMPDIR:-/tmp}/motion-gate}
export MOTION_GATE_OUT=$OUT
filter=""
while [[ $# -gt 0 ]]; do
  case "$1" in
    --sheet) export MOTION_GATE_SHEET=$2; filter=${2%%|*}; shift 2 ;;
    --dump) export MOTION_GATE_DUMP=$2; filter=${2%%|*}; shift 2 ;;
    --allowed) export MOTION_GATE_ALLOWED=1; shift ;;
    -h|--help) sed -n '2,10p' "$0"; exit 0 ;;
    *) filter=$1; shift ;;
  esac
done
export MOTION_GATE=$filter
rm -f "$OUT" "$OUT.sheet.png" "$OUT.dump"
status=0
cargo test -q -p opencode-desktop motion_gate::scenarios >/dev/null 2>&1 || status=$?
if [[ -s "$OUT" ]]; then cat "$OUT"; else echo "motion-audit-desktop: the test didn't run (exit $status); run cargo test -p opencode-desktop motion_gate to see why" >&2; exit 1; fi
[[ -f "$OUT.sheet.png" ]] && echo "sheet: $OUT.sheet.png"
[[ -f "$OUT.dump" ]] && echo "dump: $OUT.dump"
exit $status
